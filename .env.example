# Names only. Set real values in Netlify (Site configuration > Environment variables), scope "Functions",
# marked "Contains secret values" where noted. Never commit a .env file. See docs/deploy.md.
# The public app needs NO variables: its Supabase URL + publishable key are public and live in public/config/auth.json.
#
# Agent Console (Functions only):
SUPABASE_URL=               # https://ygdswggaxtyzlcscgdrf.supabase.co (not secret) - used to verify console sign-ins
SUPABASE_PUBLISHABLE_KEY=   # sb_publishable_... (public by design, not secret)
CONSOLE_ADMIN_EMAILS=       # comma-separated owner emails allowed into the console, e.g. a@example.com,b@example.com
ANTHROPIC_API_KEY=          # secret
GITHUB_TOKEN=               # secret - fine-grained PAT, one repo, Contents: Read and write
GITHUB_REPO=                # owner/repo, e.g. fenago/Flood
GITHUB_BRANCH=              # main
DAILY_TOKEN_BUDGET=         # integer, e.g. 1000000
#
# NEVER set here or in Netlify for this app: the Google OAuth client secret, a Supabase sb_secret_ key, or the legacy
# service_role key. They are not needed (Google's secret lives only in the Supabase dashboard).
